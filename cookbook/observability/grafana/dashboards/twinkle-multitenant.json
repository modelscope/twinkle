      "fieldConfig": {"defaults":{"unit":"percentunit","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"orange","value":0.8},{"color":"red","value":1}]},"min":0},"overrides":[]},
      "options": {"displayMode":"gradient","orientation":"horizontal","reduceOptions":{"calcs":["lastNotNull"],"values":false}},
