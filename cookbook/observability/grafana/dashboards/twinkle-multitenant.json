      "options": {},
      "transformations": [{"id":"renameByRegex","options":{"regex":"^([0-9a-f]{12})[0-9a-f]{52}$","renamePattern":"$1"}}],
      "targets": [{"refId":"A","expr":"sum by (user_id) (rate(twinkle_usage_requests_total{user_id=~\"(${user_id:raw}).*\",model_id=~\"${model_id:regex}\"}[5m]))","legendFormat":"{{user_id}}"}]
    },
