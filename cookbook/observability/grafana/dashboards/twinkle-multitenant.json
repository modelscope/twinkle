      "gridPos": {"x":0,"y":40,"w":24,"h":9},
      "fieldConfig": {"defaults":{},"overrides":[]},
      "targets": [{"refId":"A","queryType":"traceql","query":"{ name = \"task_queue.execute\" && span.twinkle.user_id =~ \"^(${user_id:raw}).*$\" && span.twinkle.model_id =~ \"${model_id:regex}\" }","limit":25}]
    },
    {
      "id": 1,
      "type": "timeseries",
