{
  "uid": "twinkle-multitenant",
  "title": "Twinkle Multitenant Operations",
  "schemaVersion": 40,
  "version": 1,
  "timezone": "browser",
  "refresh": "15s",
  "time": {"from":"now-1h","to":"now"},
  "editable": false,
  "links": [
    {
      "type": "link",
      "title": "Find task traces",
      "tooltip": "Open task traces for the selected time, fingerprint, and training",
      "url": "/d/twinkle-multitenant/twinkle-multitenant-operations?viewPanel=16",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": true
    },
    {
      "type": "link",
      "title": "Find training logs",
      "tooltip": "Open task logs for the selected time, training, and outcome",
      "url": "/d/twinkle-multitenant/twinkle-multitenant-operations?viewPanel=21",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "user_id",
        "label": "User fingerprint prefix",
        "type": "textbox",
        "description": "Leave blank for all users, or paste a full fingerprint or its prefix.",
        "query": "",
        "current": {"text":"","value":""}
      },
      {
        "name": "model_id",
        "label": "Model / training ID",
        "type": "query",
        "datasource": {"type":"prometheus","uid":"twinkle-mimir"},
        "definition": "label_values({__name__=~\"twinkle_http_requests_total|twinkle_usage_requests_total\"}, model_id)",
        "query": "label_values({__name__=~\"twinkle_http_requests_total|twinkle_usage_requests_total\"}, model_id)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "current": {"text":"All","value":"$__all"}
      },
      {
        "name": "node",
        "label": "Resource node",
        "type": "query",
        "datasource": {"type":"prometheus","uid":"twinkle-mimir"},
        "definition": "label_values({__name__=~\"twinkle_system_memory_usage_bytes|twinkle_gpu_utilization|twinkle_gpu_memory_usage_bytes\"}, node)",
        "query": "label_values({__name__=~\"twinkle_system_memory_usage_bytes|twinkle_gpu_utilization|twinkle_gpu_memory_usage_bytes\"}, node)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "current": {"text":"All","value":"$__all"}
      },
      {
        "name": "task_outcome",
        "label": "Log outcome",
        "type": "custom",
        "query": "Abnormal : failed|timeout|refused,queued,started,completed,failed,timeout,refused,cancelled",
        "includeAll": true,
        "allValue": ".+",
        "current": {"text":"All","value":"$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 18,
      "type": "table",
      "title": "Current trainings",
      "description": "Live training state. Select a base model or training ID to inspect that training. If the snapshot has an update time and the table has no data, no current trainings match the fingerprint.",
      "datasource": {
        "type": "redis-datasource",
        "uid": "twinkle-redis"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 19,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 105
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ACTIVE": {
                        "color": "green"
                      },
                      "PENDING": {
                        "color": "yellow"
                      },
                      "CLOSING": {
                        "color": "orange"
                      },
                      "EMPTY": {
                        "text": "No trainings",
                        "color": "text"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Base model"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 240
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open training activity",
                    "targetBlank": true,
                    "url": "/d/twinkle-multitenant/twinkle-multitenant-operations?from=${__from}&to=${__to}&var-model_id=${__data.fields[\"Training ID\"]}&${user_id:queryparam}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Token fingerprint"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 152
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "Unattributed"
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^([0-9a-f]{12})[0-9a-f]{52}$",
                      "result": {
                        "text": "$1"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Started"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Training ID"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 172
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open training activity",
                    "targetBlank": true,
                    "url": "/d/twinkle-multitenant/twinkle-multitenant-operations?from=${__from}&to=${__to}&var-model_id=${__data.fields[\"Training ID\"]}&${user_id:queryparam}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Started"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:MM-DD HH:mm:ss"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Value",
            "format": "json"
          }
        },
        {
          "id": "extractFields",
          "options": {
            "source": "rows",
            "format": "json"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "exclude": {
              "names": [
                "updated_at",
                "rows",
                "row_count"
              ]
            }
          }
        },
        {
          "id": "transpose",
          "options": {}
        },
        {
          "id": "extractFields",
          "options": {
            "source": "Value",
            "format": "json",
            "replace": true
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "all",
            "filters": [
              {
                "fieldName": "state",
                "config": {
                  "id": "regex",
                  "options": {
                    "value": ".+"
                  }
                }
              }
            ]
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "any",
            "filters": [
              {
                "fieldName": "user_id",
                "config": {
                  "id": "regex",
                  "options": {
                    "value": "^(${user_id:raw}).*$"
                  }
                }
              },
              {
                "fieldName": "state",
                "config": {
                  "id": "regex",
                  "options": {
                    "value": "^EMPTY$"
                  }
                }
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "state": 0,
              "model_id": 1,
              "user_id": 2,
              "created_at": 3,
              "training_id": 4,
              "session_id": 5
            },
            "renameByName": {
              "state": "State",
              "model_id": "Base model",
              "user_id": "Token fingerprint",
              "created_at": "Started",
              "training_id": "Training ID",
              "session_id": "Session ID"
            },
            "excludeByName": {
              "session_id": true,
              "updated_at": true
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Started",
                "destinationType": "time"
              }
            ]
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "type": "command",
          "command": "get",
          "keyName": "admin:index:trainings"
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "Started",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Training snapshot updated",
      "description": "Unavailable means the live snapshot is missing or expired. Historical panels use the selected dashboard time range.",
      "datasource": {
        "type": "datasource",
        "uid": "-- Dashboard --"
      },
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "unit": "time:MM-DD HH:mm:ss"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "value",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ],
          "fields": "/^updated_at$/"
        }
      },
      "targets": [
        {
          "refId": "A",
          "panelId": 18
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Value",
            "format": "json",
            "replace": true
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "updated_at",
                "destinationType": "time"
              }
            ]
          }
        }
      ]
    },
    {
      "id": 24,
      "type": "stat",
      "title": "Task errors in range",
      "description": "Click to see failed, timed-out, and refused tasks. No data means there are no structured task events in the selected range.",
      "datasource": {
        "type": "loki",
        "uid": "twinkle-loki"
      },
      "gridPos": {
        "x": 19,
        "y": 3,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "links": [
            {
              "title": "Open matching task logs",
              "targetBlank": true,
              "url": "/d/twinkle-multitenant/twinkle-multitenant-operations?viewPanel=21&from=${__from}&to=${__to}&${user_id:queryparam}&${model_id:queryparam}&${node:queryparam}&var-task_outcome=failed%7Ctimeout%7Crefused"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=~\".+\"} | twinkle_model_id=~\"${model_id:regex}\" | twinkle_model_id != \"\" | twinkle_user_id =~ \"(${user_id:raw}).*\" | twinkle_task_outcome =~ \"failed|timeout|refused\" [$__range])) or (sum(count_over_time({service_name=~\".+\"} | twinkle_model_id=~\"${model_id:regex}\" | twinkle_model_id != \"\" | twinkle_user_id =~ \"(${user_id:raw}).*\" | twinkle_task_outcome != \"\" [$__range])) * 0)",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 25,
      "type": "table",
      "title": "Recent training activity",
      "description": "Latest 30 trainings with queued tasks in the selected range. Filter the Base model column or use the fingerprint above. Older logs may only show when the training ran and its ID.",
      "datasource": {
        "type": "loki",
        "uid": "twinkle-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 7
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Last queued",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "—"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Base model"
            },
            "properties": [
              {
                "id": "custom.filterable",
                "value": true
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open training activity",
                    "targetBlank": true,
                    "url": "/d/twinkle-multitenant/twinkle-multitenant-operations?from=${__from}&to=${__to}&var-model_id=${__data.fields[\"training_id\"]}&${user_id:queryparam}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Training ID"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 210
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open training activity",
                    "targetBlank": true,
                    "url": "/d/twinkle-multitenant/twinkle-multitenant-operations?from=${__from}&to=${__to}&var-model_id=${__data.fields[\"training_id\"]}&${user_id:queryparam}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fingerprint"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^([0-9a-f]{12})[0-9a-f]{52}$",
                      "result": {
                        "text": "$1"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last queued"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:MM-DD HH:mm:ss"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "training_id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "twinkle_base_model": 0,
              "Value": 1,
              "owner": 2,
              "training_id": 4,
              "Value #A": 1,
              "training_ref": 3
            },
            "renameByName": {
              "Value": "Last queued",
              "twinkle_base_model": "Base model",
              "owner": "Fingerprint",
              "Value #A": "Last queued",
              "training_ref": "Training ID"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Last queued",
                "destinationType": "time"
              }
            ]
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "topk(30, topk by (training_id) (1, max_over_time({service_name=~\".+\"} |= \"[TaskQueue]\" | regexp `model_id=(?P<legacy_training>training_[0-9a-f]+)(, user_id=(?P<legacy_owner>[0-9a-f]{64}))?` | label_format training_id=`{{ .twinkle_model_id | default .legacy_training }}`, owner=`{{ .twinkle_user_id | default .legacy_owner }}` | training_id=~\"training_.+\" | owner=~\"(${user_id:raw}).*\" | label_format training_ref=`{{ .training_id | trimPrefix \"training_\" | trunc 12 }}`, last_task=`{{ __timestamp__ | unixEpochMillis }}` | unwrap last_task | __error__=\"\" [$__range]) by (training_id, training_ref, twinkle_base_model, owner)))",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Accepted requests over selected range",
      "description": "Accepted requests summed over Runtime instances. Chart labels show the first 12 characters of the Token fingerprint.",
      "datasource": {"type":"prometheus","uid":"twinkle-mimir"},
      "gridPos": {"x":0,"y":14,"w":8,"h":6},
      "fieldConfig": {"defaults":{"unit":"short","decimals":0,"min":0,"thresholds":{"mode":"absolute","steps":[{"color":"blue","value":null}]}},"overrides":[]},
      "options": {"graphMode":"none","colorMode":"value","textMode":"value_and_name"},
      "transformations": [{"id":"renameByRegex","options":{"regex":"^([0-9a-f]{12})[0-9a-f]{52}$","renamePattern":"$1"}}],
      "targets": [{"refId":"A","expr":"sum by (user_id) (last_over_time(twinkle_usage_requests_total{user_id=~\"(${user_id:raw}).*\",model_id=~\"${model_id:regex}\"}[$__range]) - (twinkle_usage_requests_total{user_id=~\"(${user_id:raw}).*\",model_id=~\"${model_id:regex}\"} offset $__range or 0 * last_over_time(twinkle_usage_requests_total{user_id=~\"(${user_id:raw}).*\",model_id=~\"${model_id:regex}\"}[$__range])))","legendFormat":"{{user_id}}","instant":true,"range":false}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Input tokens over selected range",
      "description": "",
      "datasource": {"type":"prometheus","uid":"twinkle-mimir"},
      "gridPos": {"x":8,"y":14,"w":8,"h":6},
      "fieldConfig": {"defaults":{"unit":"short","min":0,"thresholds":{"mode":"absolute","steps":[{"color":"blue","value":null}]}},"overrides":[]},
      "options": {"graphMode":"none","colorMode":"value","textMode":"value_and_name"},
      "transformations": [{"id":"renameByRegex","options":{"regex":"^([0-9a-f]{12})[0-9a-f]{52}$","renamePattern":"$1"}}],
      "targets": [{"refId":"A","expr":"sum by (user_id) (last_over_time(twinkle_usage_input_tokens_total{user_id=~\"(${user_id:raw}).*\",model_id=~\"${model_id:regex}\"}[$__range]) - (twinkle_usage_input_tokens_total{user_id=~\"(${user_id:raw}).*\",model_id=~\"${model_id:regex}\"} offset $__range or 0 * last_over_time(twinkle_usage_input_tokens_total{user_id=~\"(${user_id:raw}).*\",model_id=~\"${model_id:regex}\"}[$__range])))","legendFormat":"{{user_id}}","instant":true,"range":false}]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Run seconds over selected range",
      "description": "Sum of task execution time, without weighting by device count.",
      "datasource": {"type":"prometheus","uid":"twinkle-mimir"},
      "gridPos": {"x":16,"y":14,"w":8,"h":6},
      "fieldConfig": {"defaults":{"unit":"s","min":0,"thresholds":{"mode":"absolute","steps":[{"color":"blue","value":null}]}},"overrides":[]},
      "options": {"graphMode":"none","colorMode":"value","textMode":"value_and_name"},
      "transformations": [{"id":"renameByRegex","options":{"regex":"^([0-9a-f]{12})[0-9a-f]{52}$","renamePattern":"$1"}}],
      "targets": [{"refId":"A","expr":"sum by (user_id) (last_over_time(twinkle_usage_run_seconds_total{user_id=~\"(${user_id:raw}).*\",model_id=~\"${model_id:regex}\"}[$__range]) - (twinkle_usage_run_seconds_total{user_id=~\"(${user_id:raw}).*\",model_id=~\"${model_id:regex}\"} offset $__range or 0 * last_over_time(twinkle_usage_run_seconds_total{user_id=~\"(${user_id:raw}).*\",model_id=~\"${model_id:regex}\"}[$__range])))","legendFormat":"{{user_id}}","instant":true,"range":false}]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Queue wait p95",
      "description": "",
      "datasource": {"type":"prometheus","uid":"twinkle-mimir"},
      "gridPos": {"x":0,"y":20,"w":12,"h":8},
      "fieldConfig": {"defaults":{"unit":"s"},"overrides":[]},
      "options": {},
      "targets": [{"refId":"A","expr":"histogram_quantile(0.95, sum by (le, deployment, model_id) (rate(twinkle_task_wait_seconds_bucket{user_id=~\"(${user_id:raw}).*\",model_id=~\"${model_id:regex}\"}[5m])))","legendFormat":"{{deployment}} {{model_id}}"}]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Task execution p95",
      "description": "",
      "datasource": {"type":"prometheus","uid":"twinkle-mimir"},
      "gridPos": {"x":12,"y":20,"w":12,"h":8},
      "fieldConfig": {"defaults":{"unit":"s"},"overrides":[]},
      "options": {},
      "targets": [{"refId":"A","expr":"histogram_quantile(0.95, sum by (le, deployment, model_id) (rate(twinkle_task_execution_seconds_bucket{user_id=~\"(${user_id:raw}).*\",model_id=~\"${model_id:regex}\"}[5m])))","legendFormat":"{{deployment}} {{model_id}}"}]
    },
    {
      "id": 22,
      "type": "table",
      "title": "Task events by outcome",
      "description": "Log event counts for the selected range and training. A task can produce more than one event. Click an outcome to open its logs.",
      "datasource": {
        "type": "loki",
        "uid": "twinkle-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 6,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Outcome"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "failed": {
                        "color": "red"
                      },
                      "timeout": {
                        "color": "red"
                      },
                      "refused": {
                        "color": "orange"
                      }
                    }
                  }
                ]
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open matching task logs",
                    "targetBlank": true,
                    "url": "/d/twinkle-multitenant/twinkle-multitenant-operations?viewPanel=21&from=${__from}&to=${__to}&${user_id:queryparam}&${model_id:queryparam}&${node:queryparam}&var-task_outcome=${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Events",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (twinkle_task_outcome) (count_over_time({service_name=~\".+\"} | twinkle_model_id=~\"${model_id:regex}\" | twinkle_model_id != \"\" | twinkle_user_id =~ \"(${user_id:raw}).*\" | twinkle_task_outcome != \"\" [$__range]))",
          "queryType": "instant",
          "legendFormat": "{{twinkle_task_outcome}}"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Events",
              "twinkle_task_outcome": "Outcome"
            }
          }
        }
      ]
    },
    {
      "id": 21,
      "type": "logs",
      "title": "Training task logs",
      "description": "Shows the latest 200 lifecycle events for the selected training. Use Log outcome or narrow the time range to isolate failures and timeouts. For older logs, open the related task trace and choose Logs for this span.",
      "datasource": {
        "type": "loki",
        "uid": "twinkle-loki"
      },
      "gridPos": {"x":6,"y":28,"w":18,"h":12},
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "showLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\".+\"} | twinkle_model_id=~\"${model_id:regex}\" | twinkle_model_id != \"\" | twinkle_user_id =~ \"(${user_id:raw}).*\" | twinkle_task_outcome =~ \"${task_outcome:raw}\"",
          "queryType": "range",
          "maxLines": 200
        }
      ]
    },
